{
  "name": "buttermilk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for buttermilk — predicate-based routing for React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantizor/buttermilk.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" build",
    "test": "pnpm -r --filter=\"./packages/*\" test",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "size": "pnpm -r --filter=\"./packages/*\" size",
    "bench": "pnpm --filter @buttermilk/bench bench",
    "bench:baseline": "pnpm --filter @buttermilk/bench baseline",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter=\"./packages/*\" build && changeset publish",
    "dev:docs": "pnpm --filter docs dev",
    "dev:sandbox": "pnpm --filter sandbox dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "typescript": "^5.6.3"
  }
}
